<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<component name="SearchScreen" extends="Group">
    <interface>
        <field id="onResultSelect" type="assocarray" value="" />
        <field id="onBack" type="boolean" value="false" />
    </interface>

    <children>
        <Rectangle width="1920" height="1080" color="#0A0A0A" />
        <Label id="headerTitle" text="Search" font="font:LargeBoldSystemFont" color="#FFFFFF" translation="[40, 40]" />
        <Group id="searchGroup" translation="[40, 120]" width="1840" height="80" color="#1A1A2E">
            <TextEditBox id="searchField" translation="[0, 0]" width="1400" height="60" hint="Search channels, movies..." />
            <Button id="searchBtn" translation="[1420, 0]" width="400" height="60">
                <Label text="Search" font="font:MediumSystemFont" />
            </Button>
        </Group>
        <LabelList id="searchResultsList" translation="[40, 220]" width="1840" height="760" itemSize="[1840, 70]" />
        <Button id="backBtn" translation="[1700, 40]" width="180" height="50">
            <Label text="Back" font="font:MediumSystemFont" color="#FFFFFF" />
        </Button>
    </children>

    <script type="text/brightscript" uri="pkg:/source/playlists.brs" />
    <script type="text/brightscript" uri="pkg:/source/content.brs" />
    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />
</component>