<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<component name="ExpiryLockScreen" extends="Group">
    <interface>
        <field id="entitlement" type="assocarray" value="" />
        <field id="isLoading" type="boolean" value="false" />
        <field id="checkNotice" type="string" value="" />
        <field id="selectedAction" type="string" value="" />
    </interface>

    <children>
        <Rectangle width="1920" height="1080" color="#04060C" />
        <Rectangle width="1920" height="1080" color="#060A14" opacity="0.95" />

        <!-- Centered Brand Header -->
        <Poster uri="pkg:/images/logo.png" width="56" height="56" translation="[810, 40]" />
        <Label text="YESTREAM" font="font:LargeBoldSystemFont" color="#FFFFFF" translation="[882, 38]" />
        <Label text="PRO IPTV PLAYER" font="font:SmallBoldSystemFont" color="#38BDF8" translation="[884, 80]" />

        <!-- Lock Hero Card -->
        <Group id="lockCard" translation="[460, 150]" width="1000" height="720">
            <Rectangle width="1000" height="720" color="#0F172A" />
            <Rectangle width="1000" height="4" color="#EF4444" opacity="0.8" />

            <!-- Expiry Badge -->
            <Group id="badgeGroup" translation="[360, 35]">
                <Rectangle width="280" height="38" color="#EF4444" opacity="0.18" />
                <Label id="badgeText" text="TRIAL PERIOD EXPIRED" font="font:SmallBoldSystemFont" color="#F87171" horizAlign="center" width="280" translation="[0, 8]" />
            </Group>

            <!-- Title & Description -->
            <Label id="titleLabel" text="Your trial period has expired." font="font:LargeBoldSystemFont" color="#FFFFFF" horizAlign="center" width="1000" translation="[0, 95]" />
            <Label id="descLabel" text="To continue enjoying Live TV, Movies, Series, and EPG Timeline, please renew or activate your device." font="font:SmallSystemFont" color="#94A3B8" horizAlign="center" width="900" wrap="true" translation="[50, 145]" />

            <!-- Credentials Box (Split Screen: QR Code + MAC/Key) -->
            <!-- Left: QR Code -->
            <Poster id="qrImage" uri="pkg:/images/splash_hd.png" width="200" height="200" translation="[140, 215]" />
            <Label text="Scan with phone to activate" font="font:SmallSystemFont" color="#94A3B8" horizAlign="center" width="240" translation="[120, 430]" />

            <!-- Divider -->
            <Rectangle width="1" height="250" color="#1E293B" translation="[480, 210]" />

            <!-- Right: Device Credentials -->
            <Group translation="[530, 215]">
                <Label text="DEVICE MAC ADDRESS" font="font:SmallBoldSystemFont" color="#64748B" />
                <Rectangle width="380" height="48" color="#1E293B" translation="[0, 28]" />
                <Label id="macDisplay" text="DA:E5:4A:7C:18:3F" font="font:MediumBoldSystemFont" color="#FFFFFF" translation="[20, 39]" />

                <Label text="DEVICE ACTIVATION KEY" font="font:SmallBoldSystemFont" color="#64748B" translation="[0, 95]" />
                <Rectangle width="380" height="48" color="#1E293B" translation="[0, 123]" />
                <Label id="keyDisplay" text="187828" font="font:MediumBoldSystemFont" color="#38BDF8" translation="[20, 134]" />

                <Label text="PORTAL URL" font="font:SmallBoldSystemFont" color="#475569" translation="[0, 190]" />
                <Label id="portalLink" text="https://yestream.ai.studio/" font="font:SmallSystemFont" color="#94A3B8" translation="[0, 215]" />
            </Group>

            <!-- Action Button: Refresh Status -->
            <Group id="btnRefresh" translation="[380, 560]">
                <Rectangle id="btnRefreshBg" width="240" height="52" color="#38BDF8" />
                <Label id="btnRefreshText" text="↻  Refresh Status" font="font:MediumBoldSystemFont" color="#020617" horizAlign="center" width="240" translation="[0, 14]" />
            </Group>

            <!-- Status Notice -->
            <Label id="noticeText" text="" font="font:SmallBoldSystemFont" color="#38BDF8" horizAlign="center" width="1000" translation="[0, 640]" />
        </Group>
    </children>

    <script type="text/brightscript">
    <![CDATA[
    sub init()
        m.macDisplay = m.top.findNode("macDisplay")
        m.keyDisplay = m.top.findNode("keyDisplay")
        m.noticeText = m.top.findNode("noticeText")
        m.btnRefreshBg = m.top.findNode("btnRefreshBg")
        m.btnRefreshText = m.top.findNode("btnRefreshText")
        m.btnPlaylistsBg = m.top.findNode("btnPlaylistsBg")
        m.btnPlaylistsText = m.top.findNode("btnPlaylistsText")

        m.focusedBtn = 0 ' 0 = Refresh, 1 = Playlists
        updateFocus()
    end sub

    sub updateFocus()
        if m.focusedBtn = 0
            m.btnRefreshBg.color = "#38BDF8"
            m.btnRefreshText.color = "#020617"
            m.btnPlaylistsBg.color = "#1E293B"
            m.btnPlaylistsText.color = "#FFFFFF"
        else
            m.btnRefreshBg.color = "#1E293B"
            m.btnRefreshText.color = "#FFFFFF"
            m.btnPlaylistsBg.color = "#38BDF8"
            m.btnPlaylistsText.color = "#020617"
        end if
    end sub

    function onKeyEvent(key as String, press as Boolean) as Boolean
        if not press then return false

        if key = "left"
            if m.focusedBtn = 1
                m.focusedBtn = 0
                updateFocus()
                return true
            end if
        else if key = "right"
            if m.focusedBtn = 0
                m.focusedBtn = 1
                updateFocus()
                return true
            end if
        else if key = "OK"
            if m.focusedBtn = 0
                m.noticeText.text = "Checking activation with Yestream Cloud..."
                m.top.selectedAction = "refresh"
            else
                m.top.selectedAction = "playlists"
            end if
            return true
        end if

        return false
    end function
    ]]>
    </script>
</component>