<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<component name="YestreamScene" extends="Scene">
    <interface>
        <field id="entitlement" type="assocarray" />
        <field id="deviceId" type="string" />
        <field id="deviceKey" type="string" />
        <field id="macAddress" type="string" />
    </interface>

    <children>
        <!-- Background -->
        <Rectangle id="background" width="1920" height="1080" color="#060A13" />

        <!-- Navigation Bar -->
        <TopNavigationBar id="topNav" translation="[0, 0]" />

        <!-- Screens Container -->
        <Group id="screensContainer" translation="[0, 90]">
            <HomeScreen id="homeScreen" visible="true" />
            <MediaBrowser kind="live" id="liveTvScreen" visible="false" />
            <MediaBrowser kind="movie" id="movieScreen" visible="false" />
            <MediaBrowser kind="series" id="seriesScreen" visible="false" />
            <EPGScreen id="epgScreen" visible="false" />
            <PlaylistsScreen id="playlistsScreen" visible="false" />
            <SettingsScreen id="settingsScreen" visible="false" />
        </Group>

        <!-- Expiry Lock Overlay Screen -->
        <ExpiryLockScreen id="expiryLockScreen" visible="false" />
    </children>

    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/device-identity.brs" />
    <script type="text/brightscript" uri="pkg:/source/cloud-api.brs" />
    <script type="text/brightscript" uri="pkg:/source/access-evaluation.brs" />
    <script type="text/brightscript" uri="pkg:/source/sha256.brs" />
    <script type="text/brightscript" uri="pkg:/components/YestreamScene.brs" />
</component>