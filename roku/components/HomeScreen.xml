        <Group id="btn0" translation="[590, 625]">
            <Rectangle id="btn0Bg" width="220" height="50" color="#1E293B" />
            <Label id="btn0Text" text="↻  Refresh" font="font:MediumBoldSystemFont" color="#FFFFFF" horizAlign="center" width="220" translation="[0, 12]" />
        </Group>

        <!-- Button 1: Playlists -->
        <Group id="btn1" translation="[850, 625]">
            <Rectangle id="btn1Bg" width="220" height="50" color="#1E293B" />
            <Label id="btn1Text" text="☰  Playlists" font="font:MediumBoldSystemFont" color="#FFFFFF" horizAlign="center" width="220" translation="[0, 12]" />
        </Group>

        <!-- Button 2: Settings -->
        <Group id="btn2" translation="[1110, 625]">
            <Rectangle id="btn2Bg" width="220" height="50" color="#1E293B" />
            <Label id="btn2Text" text="⚙  Settings" font="font:MediumBoldSystemFont" color="#FFFFFF" horizAlign="center" width="220" translation="[0, 12]" />
        </Group>

        <!-- ================================================= -->
        <!-- 4. FOOTER: Real Hardware MAC & Brand Tagline      -->
        <!-- ================================================= -->
        <Label id="macFooter" text="MAC ADDRESS : DA:E5:4A:7C:18:3F" font="font:SmallBoldSystemFont" color="#64748B" horizAlign="center" width="1920" translation="[0, 715]" />
        <Label text="Yestream Pro • Ultra High Definition Streaming" font="font:SmallSystemFont" color="#475569" horizAlign="center" width="1920" translation="[0, 745]" />
